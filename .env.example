# Sorgente dati: "mock" (dati finti locali) oppure "live" (chain reale)
VITE_API_MODE=live

# --- DEV ---------------------------------------------------------------------
# Nodo verso cui il proxy Vite inoltra /api e /wallet. Usato SOLO in sviluppo.
VITE_DEV_PROXY_TARGET=http://INDIRIZZO_NODO:5000

# --- PROD --------------------------------------------------------------------
# Lista di chain node separati da virgola. Il primo e' il default; si passa al
# successivo solo se la connessione fallisce (sticky node, vedi src/api/live.ts).
# Lasciare VUOTO in sviluppo: con valore vuoto si usano path relativi e quindi il
# proxy Vite qui sopra.
VITE_NODE_URLS=
